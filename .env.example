DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,searchlab

DB_NAME=searchlab
DB_USER=searchlab
DB_PASSWORD=searchlab
DB_PORT=5432

# DB_HOST is injected by docker-compose for the searchlab service.
# Leave unset for local SQLite development.

# Host-mapped ports (compose): app 8001, db 5433, redis 6380, es 9201
REDIS_URL=redis://127.0.0.1:6380/0
ELASTICSEARCH_HOST=http://127.0.0.1:9201
